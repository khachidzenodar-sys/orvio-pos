{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORVIO",
  "version": "0.1.0",
  "identifier": "ge.orvio.pos",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm desktop:dev",
    "beforeBuildCommand": "pnpm desktop:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ORVIO",
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
